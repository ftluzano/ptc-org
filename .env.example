# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Enable Firebase Email/Password Authentication and pre-create the 12 organization and CESSCA
# accounts with verified official emails. Portal roles are mapped from those email addresses.
# Firebase Authentication web configuration (public app identifiers, not service-account keys).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Firebase Admin SDK service-account JSON. Keep this secret in your deployment environment;
# never commit a real service-account key or paste it into source code.
FIREBASE_PROJECT_ID=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Configure the shared CESSCA Turso database for cross-instance moderation and live-update signals.
# TURSO_DATABASE_URL_CESSCA=""
# TURSO_AUTH_TOKEN_CESSCA=""
# Each organization uses its own Turso database; local SQLite files are only development fallbacks.
# TURSO_DATABASE_URL_SSC=""
# TURSO_AUTH_TOKEN_SSC=""
# TURSO_DATABASE_URL_PLUMAGE=""
# TURSO_AUTH_TOKEN_PLUMAGE=""
# TURSO_DATABASE_URL_IMAGE=""
# TURSO_AUTH_TOKEN_IMAGE=""
# TURSO_DATABASE_URL_ATHLETES=""
# TURSO_AUTH_TOKEN_ATHLETES=""
# TURSO_DATABASE_URL_JPASAPS=""
# TURSO_AUTH_TOKEN_JPASAPS=""
# TURSO_DATABASE_URL_JPCS=""
# TURSO_AUTH_TOKEN_JPCS=""
# TURSO_DATABASE_URL_PMO=""
# TURSO_AUTH_TOKEN_PMO=""
# TURSO_DATABASE_URL_SFHRE=""
# TURSO_AUTH_TOKEN_SFHRE=""
# TURSO_DATABASE_URL_GIFTED=""
# TURSO_AUTH_TOKEN_GIFTED=""
# TURSO_DATABASE_URL_UG=""
# TURSO_AUTH_TOKEN_UG=""
# TURSO_DATABASE_URL_CHAMBERS=""
# TURSO_AUTH_TOKEN_CHAMBERS=""
# TURSO_DATABASE_URL_DLC=""
# TURSO_AUTH_TOKEN_DLC=""
